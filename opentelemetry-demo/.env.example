# OpenTelemetry Demo - Environment Variables
# Copy this file to .env and adjust values as needed

# OTel Collector endpoints
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Character service ports
LOWER_PORT=5053
UPPER_PORT=5054
DIGIT_PORT=5051
SPECIAL_PORT=5052
GENERATOR_PORT=5050

# Generator service: URLs for character services (used in local dev)
LOWER_SERVICE_URL=http://localhost:5053
UPPER_SERVICE_URL=http://localhost:5054
DIGIT_SERVICE_URL=http://localhost:5051
SPECIAL_SERVICE_URL=http://localhost:5052

# Load service settings
GENERATOR_URL=http://localhost:5050
LOAD_DELAY_MS=500

# TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=otel_demo

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
